---
import Institutional from '../../layouts/Institutional.astro';
import { LANGUAGES, STRINGS, type Language } from '../../lib/strings';
import { STUDY } from '../../lib/studyConfig';
import { PROVIDER_IDS, PROVIDER_NOTICES, noticeHtml } from '../../lib/providerNotice';

export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Language;
const t = STRINGS[lang];
// The provider bullet and the transfer checkbox exist once per provider,
// hidden; the page script shows the ones of the provider that answers.
const bullets = t.consent.bullets.map((b) => b.replace('{{RETENTION_END}}', STUDY.retentionEnd[lang]));
const boxes = [
  { id: 'cb-age', label: t.consent.checkboxAge },
  { id: 'cb-read', label: t.consent.checkboxRead },
];
const transferBoxes = PROVIDER_IDS.flatMap((id) => {
  const label = PROVIDER_NOTICES[id][lang].checkbox;
  return label ? [{ id: `cb-transfer-${id}`, provider: id, label: noticeHtml(label) }] : [];
});
const boxClass = 'mt-1 h-5 w-5 shrink-0 accent-[var(--tau)]';
---
<Institutional lang={lang} title={t.consent.heading} path="/consent">
  <h1 class="text-2xl font-bold">{t.consent.heading}</h1>
  <p class="mt-2 max-w-prose">{t.consent.intro}</p>

  <section class="mt-6" aria-labelledby="brief">
    <h2 id="brief" class="text-lg font-semibold">{t.consent.briefTitle}</h2>
    <ul class="mt-2 max-w-prose list-disc space-y-2 pl-5" data-testid="consent-bullets">
      {bullets.map((b) =>
        b === '{{PROVIDER_BULLET}}' ? (
          <>
            <li class="text-[var(--muted)]" role="status" data-provider-loading>{t.provider.loading}</li>
            {PROVIDER_IDS.map((id) => (
              <li data-provider-variant={id} data-testid={`provider-bullet-${id}`} hidden set:html={noticeHtml(PROVIDER_NOTICES[id][lang].bullet)} />
            ))}
          </>
        ) : (
          <li>{b}</li>
        ),
      )}
    </ul>
  </section>

  <form id="consent" class="mt-6" novalidate>
    <h2 class="text-lg font-semibold">{t.consent.confirmTitle}</h2>
    <div class="mt-2 space-y-3">
      {boxes.map((box) => (
        <label for={box.id} class="flex max-w-prose items-start gap-3">
          <input id={box.id} name={box.id} type="checkbox" class={boxClass} data-consent-box />
          <span>{box.label}</span>
        </label>
      ))}
      {transferBoxes.map((box) => (
        <div data-provider-variant={box.provider} hidden>
          <label for={box.id} class="flex max-w-prose items-start gap-3">
            <input id={box.id} name={box.id} type="checkbox" class={boxClass} data-provider-box={box.provider} />
            <span set:html={box.label} />
          </label>
        </div>
      ))}
    </div>

    <p id="error" class="mt-4 text-sm text-red-800" role="alert" hidden>{t.consent.error}</p>
    <p class="mt-4 text-sm text-red-800" role="alert" data-provider-error data-testid="provider-error" hidden>{t.provider.unavailable}</p>

    <div class="mt-6 flex flex-col gap-3 sm:flex-row">
      <button
        id="start"
        type="submit"
        disabled
        data-testid="consent-start"
        class="rounded border border-[var(--tau)] bg-[var(--tau)] px-6 py-3 text-lg font-semibold text-white disabled:cursor-not-allowed disabled:opacity-50"
      >{t.consent.start}</button>
      <a
        href={`/${lang}/declined`}
        data-testid="consent-decline"
        class="rounded border border-[var(--rule)] px-6 py-3 text-center text-lg text-[var(--ink)]"
      >{t.consent.decline}</a>
    </div>
  </form>

  <p class="mt-8 text-sm text-[var(--muted)]">
    <a class="underline" href={`/${lang}/info/research-notification`} target="_blank" rel="noreferrer">{t.consent.linksResearch}</a>
    {' · '}
    <a class="underline" href={`/${lang}/info/privacy-notice`} target="_blank" rel="noreferrer">{t.consent.linksPrivacy}</a>
    {' '}{t.consent.linksHint}
  </p>

  <script>
    // The session is created only here, only after every box is ticked and
    // only once the page knows which provider answers (its texts are what the
    // participant consents to). A reload starts from unticked boxes (the
    // browser is told not to restore).
    import { createConversation, createSession, type ProviderId } from '../../lib/participantApi';
    import { showProvider } from '../../lib/provider';
    import { clearSession, getSessionId, setConversationId, setSessionId } from '../../lib/session';
    import { STUDY } from '../../lib/studyConfig';
    import type { Language } from '../../lib/strings';

    const lang = document.documentElement.lang as Language;
    const form = document.getElementById('consent') as HTMLFormElement;
    const start = document.getElementById('start') as HTMLButtonElement;
    const error = document.getElementById('error') as HTMLParagraphElement;
    const transferBoxes = Array.from(form.querySelectorAll<HTMLInputElement>('[data-provider-box]'));
    // The boxes that must be ticked: age, read, and the transfer box of the
    // provider that answers, if its block has one.
    const boxes = () => Array.from(form.querySelectorAll<HTMLInputElement>('[data-consent-box]'));
    let provider: ProviderId | null = null;

    // Every consent starts a new session: a session stored on this device
    // from an earlier visit (perhaps another person's) is never reused. Only
    // a session created on this page, before a failed conversation call, is
    // reused by the retry below.
    clearSession();
    form.setAttribute('autocomplete', 'off');
    const update = () => (start.disabled = provider === null || !boxes().every((b) => b.checked));
    const reset = () => {
      form.querySelectorAll<HTMLInputElement>('input[type="checkbox"]').forEach((b) => (b.checked = false));
      update();
    };
    form.addEventListener('change', update);

    const loadProvider = async () => {
      provider = null;
      update();
      const info = await showProvider();
      transferBoxes.forEach((b) => {
        b.checked = false;
        b.toggleAttribute('data-consent-box', info !== null && b.dataset.providerBox === info.provider);
      });
      provider = info?.provider ?? null;
      update();
    };

    reset();
    void loadProvider();
    // Coming back through the browser's page cache keeps the old ticks; reset
    // them and ask again, since the provider may have changed meanwhile.
    window.addEventListener('pageshow', (event) => {
      if (!event.persisted) return;
      clearSession();
      reset();
      void loadProvider();
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (provider === null || !boxes().every((b) => b.checked)) return;
      // What was consented to: the wording version and the provider block shown.
      const consentVersion = `${STUDY.consentVersion}+${provider}`;
      start.disabled = true;
      error.hidden = true;
      const begin = async () => {
        // A retry after a failed conversation call reuses the session already created.
        let sessionId = getSessionId();
        if (!sessionId) {
          const session = await createSession(consentVersion, lang);
          sessionId = session.id;
          setSessionId(sessionId);
        }
        const conversationId = await createConversation(sessionId, lang);
        setConversationId(conversationId);
        window.location.assign(`/${lang}/chat`);
      };
      try {
        try {
          await begin();
        } catch (err) {
          // A stored session the server has closed (survey done, data deleted):
          // forget it and start once more with a new one.
          if (!(err instanceof Error && err.message === 'session-finished')) throw err;
          clearSession();
          await begin();
        }
      } catch {
        error.hidden = false;
        update();
      }
    });
  </script>
</Institutional>

---
// The chat page (spec V7, V8, V9): consent guard, typed or spoken input, the
// reply as text and as speech from one avatar for every condition.
import Chat from '../../layouts/Chat.astro';
import { LANGUAGES, STRINGS, type Language } from '../../lib/strings';

export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Language;
const t = STRINGS[lang];
---
<Chat lang={lang} title={t.chat.placeholderTitle}>
  <p id="error" class="m-4 text-sm text-red-800" role="alert" hidden>{t.consent.error} <a href={`/${lang}/`} class="underline">{t.chat.backToStart}</a></p>

  <div id="page" class="chat-page" hidden>
    <header class="chat-header">
      <span class="chat-brand">{t.appName}</span>
      <div class="chat-actions">
        <button id="back" type="button" class="btn-ghost" data-testid="chat-back">{t.chat.backToStart}</button>
        <button id="end" type="button" class="btn-ghost btn-end" data-testid="chat-end">{t.chat.endConversation}</button>
      </div>
    </header>

    <section id="stage" class="stage" data-testid="stage" data-avatar-mode="loading" aria-label="Avatar">
      <div id="avatar" class="avatar"></div>
      <img id="still" class="still" src="/avatar/man-still.png" alt="" hidden />
      <button id="sound-prompt" type="button" class="sound-prompt" hidden>{t.chat.enableSound}</button>
    </section>

    <div id="transcript" class="transcript" data-testid="transcript" aria-live="polite"></div>

    <footer class="composer-wrap">
      <div class="notes">
        <p id="status" class="status" data-testid="status" aria-live="polite"></p>
        <p id="hint" class="hint" data-testid="hint" aria-live="polite"></p>
      </div>
      <form id="composer" class="composer" autocomplete="off">
        <button id="mic" type="button" class="mic" data-testid="mic" aria-label={t.chat.holdToTalk} title={t.chat.holdToTalk}>
          <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path fill="currentColor" d="M12 15a4 4 0 0 0 4-4V6a4 4 0 0 0-8 0v5a4 4 0 0 0 4 4Zm6-4a6 6 0 0 1-12 0H4a8 8 0 0 0 7 7.93V22h2v-3.07A8 8 0 0 0 20 11h-2Z"/></svg>
        </button>
        <input id="message" name="message" type="text" class="message" placeholder={t.chat.inputPlaceholder} data-testid="message" enterkeyhint="send" />
        <button id="send" type="submit" class="send" data-testid="send">{t.chat.send}</button>
      </form>
      <p class="hint-static">{t.chat.privacyHint} {t.chat.noSound}</p>
    </footer>
  </div>

  <script>
    import { startChat } from '../../scripts/chat';
    startChat().catch((err) => {
      console.error(err);
      const error = document.getElementById('error') as HTMLElement;
      error.hidden = false;
    });
  </script>
</Chat>

<style is:global>
  .chat-body { background: #f4f3f7; color: #1b1a22; }
  .chat-page { display: flex; flex-direction: column; height: 100dvh; max-width: 48rem; margin: 0 auto; }
  /* One row on every phone: the brand gives way to the two buttons on narrow screens. */
  .chat-header { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; padding: 0.4rem max(1rem, env(safe-area-inset-right, 0px)) 0.4rem max(1rem, env(safe-area-inset-left, 0px)); }
  .chat-brand { font-weight: 700; letter-spacing: 0.02em; color: #4e008e; white-space: nowrap; }
  .chat-actions { display: flex; gap: 0.5rem; }
  .btn-ghost { font: inherit; font-size: 0.8rem; white-space: nowrap; padding: 0.35rem 0.7rem; border-radius: 999px; border: 1px solid #c9c4d6; background: #fff; color: #1b1a22; }
  @media (max-width: 430px) { .chat-brand { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; } .chat-actions { width: 100%; justify-content: space-between; } }
  .btn-end { border-color: #4e008e; color: #4e008e; font-weight: 600; }
  /* The avatar card ends with a gap before the transcript; its shadow stays inside that gap. */
  .stage { position: relative; flex: 0 0 auto; height: min(34dvh, 22rem); margin: 0 1rem 0.5rem; border-radius: 1.25rem; overflow: hidden; background: radial-gradient(120% 90% at 50% 100%, #e9e4f5 0%, #ffffff 70%); box-shadow: 0 2px 8px rgba(78, 0, 142, 0.10); }
  @media (max-height: 680px) { .stage { height: 28dvh; } }
  .avatar { position: absolute; inset: 0; }
  .still { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .sound-prompt { position: absolute; left: 50%; bottom: 0.75rem; transform: translateX(-50%); font: inherit; font-size: 0.875rem; padding: 0.5rem 0.9rem; border-radius: 999px; border: 0; background: #4e008e; color: #fff; }
  /* The transcript is its own scroll area: bubbles fade at its edges instead of being cut by the avatar card. */
  .transcript { position: relative; flex: 1 1 auto; min-height: 0; overflow-y: auto; padding: 0.75rem 1rem; display: flex; flex-direction: column; gap: 0.5rem; -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 0.75rem, #000 calc(100% - 0.75rem), transparent 100%); mask-image: linear-gradient(to bottom, transparent 0, #000 0.75rem, #000 calc(100% - 0.75rem), transparent 100%); }
  .transcript > :first-child { margin-top: auto; }
  .bubble { max-width: 85%; padding: 0.6rem 0.9rem; border-radius: 1.1rem; line-height: 1.45; white-space: pre-wrap; overflow-wrap: anywhere; }
  .bubble-user { align-self: flex-end; background: #4e008e; color: #fff; border-bottom-right-radius: 0.35rem; }
  .bubble-assistant { align-self: flex-start; background: #fff; border: 1px solid #e3dfeb; border-bottom-left-radius: 0.35rem; }
  .bubble .spoken { color: #1b1a22; }
  .bubble-assistant:has(.spoken) { color: #8a85a0; }
  .composer-wrap { flex: 0 0 auto; padding: 0.25rem max(1rem, env(safe-area-inset-right, 0px)) max(0.5rem, env(safe-area-inset-bottom, 0px)) max(1rem, env(safe-area-inset-left, 0px)); background: #f4f3f7; }
  .notes { display: flex; gap: 0.75rem; min-height: 1.2em; margin: 0 0 0.25rem; font-size: 0.8rem; line-height: 1.2; }
  .status { margin: 0; color: #4e008e; white-space: nowrap; }
  .hint { margin: 0; color: #8a2d00; }
  .composer { display: flex; align-items: center; gap: 0.5rem; }
  .mic { flex: 0 0 auto; width: 3rem; height: 3rem; border-radius: 50%; border: 0; background: #4e008e; color: #fff; display: grid; place-items: center; touch-action: none; user-select: none; -webkit-user-select: none; -webkit-touch-callout: none; }
  .mic.recording { background: #c81e1e; box-shadow: 0 0 0 6px rgba(200, 30, 30, 0.25); }
  .mic:disabled, .send:disabled { opacity: 0.5; }
  .message { flex: 1 1 auto; min-width: 0; font: inherit; font-size: 1rem; padding: 0.65rem 0.9rem; border-radius: 999px; border: 1px solid #c9c4d6; background: #fff; }
  .send { flex: 0 0 auto; font: inherit; font-weight: 600; padding: 0.65rem 1rem; border-radius: 999px; border: 0; background: #4e008e; color: #fff; }
  .hint-static { margin: 0.4rem 0 0; font-size: 0.7rem; line-height: 1.3; color: #6b6680; }
  @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
</style>

---
import Institutional from '../../layouts/Institutional.astro';
import { LANGUAGES, STRINGS, type Language } from '../../lib/strings';

export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Language;
const t = STRINGS[lang];
---
<Institutional lang={lang} title={t.landing.title} path="/">
  <h1 class="text-3xl font-bold">{t.landing.title}</h1>
  <p class="mt-2 text-sm text-[var(--muted)]" data-testid="study-line">{t.landing.studyLine}</p>
  <p class="mt-6 max-w-prose">{t.landing.intro}</p>
  <button
    id="start"
    type="button"
    data-testid="landing-start"
    data-starting={t.landing.starting}
    class="mt-8 w-full rounded border border-[var(--tau)] bg-[var(--tau)] px-6 py-4 text-lg font-semibold text-white disabled:opacity-60 sm:w-auto"
  >{t.landing.start}</button>
  <p id="error" class="mt-3 text-sm text-red-800" role="alert" hidden>{t.consent.error}</p>

  <script>
    // Start: a stored session that the server still reports as consented gets
    // a new conversation (no second consent in the same visit); anything else
    // goes to the consent page.
    import { createConversation, getSession } from '../../lib/participantApi';
    import { clearSession, getSessionId, setConversationId } from '../../lib/session';
    import type { Language } from '../../lib/strings';

    const lang = document.documentElement.lang as Language;
    const button = document.getElementById('start') as HTMLButtonElement;
    const error = document.getElementById('error') as HTMLParagraphElement;
    const starting = button.dataset.starting;

    button.addEventListener('click', async () => {
      button.disabled = true;
      error.hidden = true;
      const label = button.textContent;
      if (starting) button.textContent = starting;
      try {
        const id = getSessionId();
        const session = id ? await getSession(id) : null;
        if (!session || !session.consent_accepted_at) {
          clearSession();
          window.location.assign(`/${lang}/consent`);
          return;
        }
        const conversationId = await createConversation(session.id, lang);
        setConversationId(conversationId);
        window.location.assign(`/${lang}/chat`);
      } catch (err) {
        const reason = err instanceof Error ? err.message : '';
        if (reason === 'session-missing' || reason === 'consent-required') {
          clearSession();
          window.location.assign(`/${lang}/consent`);
          return;
        }
        error.hidden = false;
        button.textContent = label;
        button.disabled = false;
      }
    });
  </script>
</Institutional>

# Database (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./societal_discussion.db

# Model providers: set one key or both. LLM_PROVIDER picks the one that
# answers ("openai" or "anthropic"); LLM_MODEL picks the model (empty = the
# provider's recommended model: gpt-6-astra, claude-sonnet-5-5). The admin
# panel (Settings, LLM provider) can switch between them without a restart.
OPENAI_API_KEY=sk-xxxxx
ANTHROPIC_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=

# Encryption secret for API key storage
ENCRYPTION_SECRET=change-me-to-random-string

# Admin panel password
ADMIN_PASSWORD=admin123

# CORS
CORS_ORIGINS=http://localhost:3000

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Database (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./societal_discussion.db

# OpenAI API (default model: GPT-5.4 — 1M context. Get a key at https://platform.openai.com)
OPENAI_API_KEY=sk-xxxxx

# Anthropic API (optional — placeholder for future use, leave blank if unused)
# ANTHROPIC_API_KEY=sk-ant-xxxxx

# Encryption secret for API key storage
ENCRYPTION_SECRET=change-me-to-random-string

# Admin panel password
ADMIN_PASSWORD=admin123

# CORS
CORS_ORIGINS=http://localhost:3000

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

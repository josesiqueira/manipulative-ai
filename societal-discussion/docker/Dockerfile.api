FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    "fastapi>=0.109.0" \
    "uvicorn[standard]>=0.27.0" \
    "sqlalchemy>=2.0.0" \
    "alembic>=1.13.0" \
    "pydantic>=2.5.0" \
    "pydantic-settings>=2.1.0" \
    "openai>=1.0.0" \
    "anthropic>=0.18.0" \
    "cryptography>=42.0.0" \
    "python-multipart>=0.0.6" \
    "python-dotenv>=1.0.0" \
    "aiosqlite>=0.19.0" \
    "asyncpg>=0.29.0"

COPY apps/api/src ./src
COPY apps/api/alembic ./alembic
COPY apps/api/alembic.ini .

# Rahti runs the container as an arbitrary UID. Make /app and /data
# readable/writable by group 0 so the random UID (which is in group 0
# under OpenShift's restricted-v2 SCC) can write the SQLite DB.
RUN mkdir -p /data \
    && chgrp -R 0 /app /data \
    && chmod -R g+rwX /app /data

EXPOSE 8080

CMD ["sh", "-c", "alembic upgrade head && uvicorn src.main:app --host 0.0.0.0 --port 8080"]
